{
  "name": "commutelab",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Hands-free commute benchmarking for NYC: GPS phase detection, a commute simulator and real MTA + Citi Bike data.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/",
    "data": "node scripts/build-nyc-data.mjs"
  },
  "dependencies": {
    "lucide-react": "0.577.0",
    "maplibre-gl": "4.7.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.30",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  }
}
